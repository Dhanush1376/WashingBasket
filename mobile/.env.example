# Washing Basket Mobile Environment Configuration
# Copy this file to .env or .env.local to configure your environment.
# Note: Variables prefixed with EXPO_PUBLIC_ are bundled into JavaScript and visible on the client.
# NEVER put private backend secrets or private API keys here.

# Deployed Backend API URL (optional in standalone demo mode; set when connecting to live backend)
# EXPO_PUBLIC_API_URL=https://api.washingbasket.com

# Mock Relay URL for syncing multi-device test sessions with the Admin Portal (optional in development; set to "off" to disable)
# EXPO_PUBLIC_MOCK_RELAY_URL=off
